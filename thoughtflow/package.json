{
  "name": "thoughtflow",
  "productName": "ThoughtFlow",
  "version": "0.8.0",
  "description": "Box와 Route로 사고의 흐름을 기록하는 데스크톱 앱",
  "author": "hoje05",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit -p tsconfig.json && tsc -p electron/tsconfig.json && vite build && node scripts/build-electron.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p electron/tsconfig.json",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --dir",
    "e2e": "npm run build && node e2e/run-all.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-blockquote": "^3.31.3",
    "@tiptap/extension-bold": "^3.31.3",
    "@tiptap/extension-code": "^3.31.3",
    "@tiptap/extension-code-block": "^3.31.3",
    "@tiptap/extension-document": "^3.31.3",
    "@tiptap/extension-heading": "^3.31.3",
    "@tiptap/extension-horizontal-rule": "^3.31.3",
    "@tiptap/extension-italic": "^3.31.3",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extension-paragraph": "^3.31.3",
    "@tiptap/extension-strike": "^3.31.3",
    "@tiptap/extension-text": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.56.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.thoughtflow.app",
    "productName": "ThoughtFlow",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "tflow",
        "name": "ThoughtFlow Board",
        "description": "ThoughtFlow 보드",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ThoughtFlow",
      "artifactName": "ThoughtFlow-Setup-${version}.${ext}"
    },
    "publish": null,
    "extraResources": [
      {
        "from": "dist-mcp/ThoughtFlow.mcpb",
        "to": "ThoughtFlow.mcpb"
      },
      {
        "from": "dist-mcp/bundle/server/index.js",
        "to": "mcp/thoughtflow-mcp.js"
      }
    ]
  }
}
